---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { items: { src: ImageMetadata; alt: string }[]; caption?: string; columns?: number; mobileColumns?: number }
const { items, caption, columns = 4, mobileColumns = 2 } = Astro.props;
const fulls = await Promise.all(items.map((i) => getImage({ src: i.src, format: 'webp' })));
---
<figure class="gallery is-wide" style={`--cols:${columns};--mcols:${mobileColumns}`}>
  <ul>
    {items.map((it, i) => (
      <li><a href={fulls[i].src} data-lightbox data-caption={it.alt}><Image src={it.src} alt={it.alt} widths={columns <= 2 ? [400, 700, 1000, 1320] : [320, 640, 900]} sizes={`(max-width: 743px) ${Math.round(100/mobileColumns)}vw, ${Math.round(1344/columns)}px`} /><span class="visually-hidden">(opens enlarged image)</span></a></li>
    ))}
  </ul>
  {caption && <figcaption class="t-body-caption text-muted">{caption}</figcaption>}
</figure>
<style>
  .gallery { margin-top: var(--space-6); display: grid; gap: var(--space-3); }
  ul { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr)); gap: var(--space-6); }
  a { display: block; border-radius: var(--radius-md); overflow: hidden; cursor: zoom-in; }
  img { width: 100%; height: auto; display: block; }
  figcaption { width: min(100%, var(--content)); justify-self: center; }
  @media (max-width: 743px) { ul { grid-template-columns: repeat(var(--mcols, 2), minmax(0, 1fr)); gap: var(--space-4); } }
</style>
