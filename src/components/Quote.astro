---
// Testimonial / quote element (design system): italic quote copy, accent quote mark, attribution below.
interface Props { by: string; role?: string }
const { by, role } = Astro.props;
---
<figure class="quote is-content">
  <span class="quote__mark" aria-hidden="true">“</span>
  <blockquote class="quote__text t-quote-large"><p><slot /></p></blockquote>
  <figcaption class="quote__by t-body-default"><strong>{by}</strong>{role && <span class="quote__role">{role}</span>}</figcaption>
</figure>
<style>
  .quote { position: relative; margin: var(--space-12) 0 0; max-width: 880px; display: grid; gap: var(--space-4); padding-top: var(--space-8); }
  .quote__mark { position: absolute; top: -0.15em; left: -0.04em; font-size: 6rem; line-height: 1; font-weight: 800; color: var(--accent-fill, var(--color-accent-green-fill)); }
  .quote__text { margin: 0; color: var(--color-text-primary); }
  .quote__text p { margin: 0; }
  .quote__text p::before { content: '“'; } .quote__text p::after { content: '”'; }
  .quote__by { display: grid; gap: 2px; color: var(--color-text-secondary); font-style: normal; }
  .quote__by strong { color: var(--color-text-primary); font-weight: 700; }
  .quote__role { color: var(--color-text-muted); font-size: 0.875rem; }
  @media (max-width: 743px) { .quote__mark { font-size: 4.5rem; } .quote { padding-top: var(--space-6); } }
</style>
