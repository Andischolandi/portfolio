---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props { entry: CollectionEntry<'cases'> }
const { entry } = Astro.props; const d = entry.data;
const href = `/cases/${entry.id}/`;
---
<article class="small" data-accent={d.accent}>
  <div class="small__media">
    <Image class="small__img" src={d.keyVisual} alt="" widths={[400, 720, 864]} sizes="(max-width: 743px) 100vw, (max-width: 1023px) 50vw, 360px" style={`object-position:${d.focus}`} />
  </div>
  <div class="small__body">
    <p class="small__meta t-label-caps-small">{d.timeframe} · {d.company}</p>
    <h3 class="small__title accent">{d.draft ? `${d.title} ${d.tagline}` : <a href={href}>{d.title} {d.tagline}</a>}</h3>
    <div class="small__more"><p class="small__desc">{d.draft ? 'Case study coming soon' : d.teaser}</p></div>
  </div>
</article>
<style>
  /* Figma: ProjectCard Small 432×300 — hover: 3px accent frame, image shrinks, short description appears */
  .small { position: relative; display: grid; grid-template-rows: auto 1fr; background: #fff; border: 1px solid var(--color-border-default); border-radius: 3px; overflow: hidden; }
  .small::after { content: ''; position: absolute; inset: -1px; border: 3px solid var(--accent-text); border-radius: 3px; opacity: 0; transition: opacity .2s ease; pointer-events: none; }
  .small__media { aspect-ratio: 432 / 215; overflow: hidden; background: #e9e7e1; transition: aspect-ratio .3s ease; }
  .small :global(.small__img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .small__body { display: grid; align-content: start; gap: var(--space-2); padding: var(--space-4); border-top: 1px solid var(--color-border-default); }
  .small__meta { margin: 0; color: #555566; }
  .small__title { margin: 0; font-weight: 700; font-size: 1.125rem; line-height: 1.444; letter-spacing: -0.005em; }
  .small a { color: inherit; text-decoration: none; } .small a::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .small a:focus-visible { outline: none; }
  .small__desc { margin: 0; font-size: 0.875rem; line-height: 1.714; color: #555566; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  @media (hover: hover) and (min-width: 1024px) {
    .small__more { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .3s ease; }
    .small__more > p { min-height: 0; }
    .small:hover::after, .small:focus-within::after { opacity: 1; }
    .small:hover .small__media, .small:focus-within .small__media { aspect-ratio: 432 / 185; }
    .small:hover .small__more, .small:focus-within .small__more { grid-template-rows: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { .small *, .small::after { transition: none !important; } }
</style>
