---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props { entry: CollectionEntry<'cases'>; headingLevel?: 'h2' | 'h3' }
const { entry, headingLevel: H = 'h3' } = Astro.props;
const d = entry.data;
const href = `/cases/${entry.id}/`;
---
<article class="card" data-theme="night" data-accent={d.accent}>
  <div class="card__media">
    <Image class="card__img" src={d.keyVisual} alt="" widths={[480, 660, 1000, 1320]} sizes="(max-width: 743px) 100vw, (max-width: 1440px) 50vw, 660px" style={`object-position:${d.focus}`} />
  </div>
  <div class="card__overlay">
    <p class="card__meta t-label-caps-small accent">{d.timeframe} · {d.company}</p>
    <H class="card__title">
      {d.draft ? <span>{d.title} <span class="accent">{d.tagline}</span></span>
               : <a href={href} class="card__link">{d.title} <span class="accent">{d.tagline}</span></a>}
    </H>
    <div class="card__more">
      <div>
        <p class="card__desc">{d.teaser}</p>
        <p class="card__cta" aria-hidden="true">{d.draft ? 'Case study coming soon' : 'Read case study →'}</p>
      </div>
    </div>
  </div>
</article>
<style>
  /* Figma: ProjectCard 660×460, radius 3, 3px accent line, overlay expands on hover (desktop) */
  .card { position: relative; border-radius: 3px; overflow: hidden; background: #161820; color: #fff; }
  .card::before { content: ''; position: absolute; z-index: 2; left: 0; right: 0; top: 0; height: 3px; background: var(--accent-fill); }
  .card__media { position: relative; aspect-ratio: 660 / 460; overflow: hidden; background: #1a1a22; }
  .card :global(.card__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .card__overlay { display: grid; gap: var(--space-3); padding: var(--space-4) var(--space-6) var(--space-6); }
  .card__meta { margin: 0; }
  .card__title { margin: 0; font-weight: 700; font-size: 1.5rem; line-height: 1.333; letter-spacing: -0.01em; text-wrap: balance; }
  .card__link { color: inherit; text-decoration: none; }
  .card__link::after { content: ''; position: absolute; inset: 0; z-index: 3; } /* whole card clickable, one link for screen readers */
  .card__link:focus-visible { outline: none; }
  .card:has(.card__link:focus-visible) { outline: 3px solid var(--accent-fill); outline-offset: 3px; }
  .card__desc { margin: 0; font-size: 0.875rem; line-height: 1.714; color: #fff; }
  .card__cta { margin: var(--space-3) 0 0; font-size: 0.6875rem; line-height: 18px; font-weight: 600; letter-spacing: 0.04em; color: rgba(255,255,255,.76); }

  /* Desktop with a mouse: text sits on the image, overlay grows on hover */
  @media (hover: hover) and (min-width: 1024px) {
    .card__overlay { position: absolute; z-index: 1; left: 0; right: 0; bottom: 0; gap: 0; padding: var(--space-4) var(--space-6) var(--space-6);
      border-top: 1px solid #2a2c36; background: linear-gradient(180deg, rgba(0,0,0,.35), rgba(0,0,0,.6)); transition: padding .3s ease; }
    .card__overlay::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(0,0,0,.5), rgba(0,0,0,.75)); opacity: 0; transition: opacity .3s ease; }
    .card__meta { margin-bottom: var(--space-3); }
    .card__title { font-size: clamp(1.25rem, 1.67vw, 1.5rem); }
    .card__more { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .3s ease; }
    .card__more > div { overflow: hidden; }
    .card__desc { padding-top: var(--space-3); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .card:hover .card__overlay, .card:focus-within .card__overlay { padding-top: var(--space-5, 20px); }
    .card:hover .card__overlay::before, .card:focus-within .card__overlay::before { opacity: 1; }
    .card:hover .card__more, .card:focus-within .card__more { grid-template-rows: 1fr; }
    .card:hover :global(.card__img), .card:focus-within :global(.card__img) { transform: scale(1.03); }
  }
  /* Tablet, phone and touch: image on top, full text below (hover content always visible) */
  @media (hover: none), (max-width: 1023px) {
    .card__media { aspect-ratio: 3 / 2; }
    .card__overlay { border-top: 1px solid #2a2c36; }
    .card__title { font-size: 1.25rem; line-height: 1.4; }
    .card__desc { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  }
  @media (max-width: 743px) { .card__overlay { padding: var(--space-4) var(--space-4) var(--space-5, 20px); gap: var(--space-2); } .card__title { font-size: 1.125rem; } }
  @media (prefers-reduced-motion: reduce) { .card *, .card :global(.card__img), .card__overlay::before { transition: none !important; } }
</style>
