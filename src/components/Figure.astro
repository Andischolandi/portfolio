---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; caption?: string; layout?: 'wide' | 'content' }
const { src, alt, caption, layout = 'wide' } = Astro.props;
const full = await getImage({ src, format: 'webp', width: Math.min(src.width, 2800) });
const w = layout === 'wide' ? 1344 : 1120;
---
<figure class:list={['figure', layout === 'wide' ? 'is-wide' : 'is-content']}>
  <a class="figure__link" href={full.src} data-lightbox data-caption={caption}>
    <Image src={src} alt={alt} widths={[800, w, Math.min(src.width, w * 2)]} sizes={`(max-width: 1440px) 100vw, ${w}px`} />
    <span class="visually-hidden">(opens enlarged image)</span>
  </a>
  {caption && <figcaption class="t-body-caption text-muted">{caption}</figcaption>}
</figure>
<style>
  .figure { margin-top: var(--space-6); display: grid; gap: var(--space-3); }
  /* captions start at the content column of the grid, not at the image edge */
  .figure.is-wide figcaption { width: min(100%, var(--content)); justify-self: center; }
  .figure__link { position: relative; display: block; border-radius: var(--radius-md); overflow: hidden; cursor: zoom-in; }
  .figure__link img { width: 100%; }
</style>
