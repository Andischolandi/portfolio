---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/inter/latin-800.css';
import '@fontsource/inter/latin-400-italic.css';
import '@fontsource/inter/latin-600-italic.css';
import '@fontsource/kalam/latin-700.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';

interface Props { title: string; description?: string; active?: 'projects' | 'about' | 'contact' | null; }
const { title, description = 'Andreas Schwankl — Product Design Director. Design and research leadership for digital products.', active = null } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Andreas Schwankl" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <script is:inline>
      /* Every page visit starts at the top (also after back/forward and reload), unless a #anchor is targeted */
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      addEventListener('pageshow', function () { if (!location.hash) scrollTo(0, 0); });
    </script>
  </head>
  <body>
    <a class="skip-link t-ui-button" href="#main">Skip to content</a>
    <Nav active={active} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Lightbox />
  </body>
</html>
