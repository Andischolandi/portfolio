---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found — Andreas Schwankl" description="This page doesn't exist.">
  <section class="section" data-theme="sand" aria-labelledby="nf-title">
    <div class="is-content nf">
      <p class="t-label-caps-large kicker">Error 404</p>
      <h1 id="nf-title" class="t-display-h1">This page took a <span class="t-script">detour</span>.</h1>
      <p class="t-body-large text-secondary">The page you're looking for doesn't exist or has moved.</p>
      <p class="nf__buttons">
        <a class="btn btn--primary t-ui-button" href="/">Back to home <span aria-hidden="true">→</span></a>
        <a class="btn btn--secondary t-ui-button" href="/projects/">View case studies <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>
</Base>
<style>
  .nf { display: grid; gap: var(--space-6); max-width: 52rem; min-height: 40vh; align-content: center; }
  .nf__buttons { display: flex; flex-wrap: wrap; gap: var(--space-3); }
</style>
