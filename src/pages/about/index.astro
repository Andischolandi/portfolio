---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ContactTeaser from '../../components/ContactTeaser.astro';
import portrait from '../../assets/profile/profile-about.png';
import type { ImageMetadata } from 'astro';
import processArrows from '../../content/cases/illustrations/process-bg-arrows.png';
const cv = '/cv/CV_Andreas-Schwankl_2026-10_eng.pdf';
// Hero pills jump to the sections below
const jumps = [
  { label: 'Values & Principles', href: '#values' },
  { label: 'Design Approach', href: '#approach' },
  { label: 'Experience', href: '#experience' },
];
// Values & Principles — tarot cards (front: illustration, back: the principle)
const cards = import.meta.glob<{ default: ImageMetadata }>('../../content/cases/illustrations/card-*.png', { eager: true });
const card = (slug: string, side: 'front' | 'back') => cards[`../../content/cases/illustrations/card-${slug}-${side}.png`].default;
const ordinals = ['first', 'second', 'third', 'fourth', 'fifth', 'sixth'];
const values = [
  { n: 'I', name: 'The Listener', slug: '1-listener', t: 'Human-Centered Design', d: 'Every decision starts with real people — their needs, behaviours and barriers. I bring user evidence into rooms where it is usually missing.' },
  { n: 'II', name: 'The Clarifier', slug: '2-clarifier', t: 'Clarity Over Complexity', d: 'I turn overwhelming findings into a few clear priorities that teams can act on.' },
  { n: 'III', name: 'The Alliance', slug: '3-alliance', t: 'Collaborative Leadership', d: 'Great outcomes need shared ownership. I build alliances across product, engineering, editorial and leadership.' },
  { n: 'IV', name: 'The Alchemist', slug: '4-alchemist', t: 'Iterative Excellence', d: 'Perfect is the enemy of progress. I believe in launching, learning, and iterating quickly while maintaining high standards for craft and quality.' },
  { n: 'V', name: 'The Guardian', slug: '5-guardian', t: 'Ethical Responsibility', d: 'Design has power and responsibility. I advocate for inclusive, accessible experiences that work for everyone.' },
  { n: 'VI', name: 'The Navigator', slug: '6-navigator', t: 'Strategic Thinking', d: 'Design decisions must serve users and the business. I connect them to roadmaps, costs and long-term goals.' },
];
// Design approach — each step links to the case studies where it shows
const ITV = { label: 'Interactive TV', accent: 'pink' };
const A11Y = { label: 'Accessibility', accent: 'green' };
const UMA = { label: 'Cornelsen', accent: 'archive-violet' };
const approach = [
  { t: 'Discover & Understand', d: 'Deep user research, stakeholder interviews and competitive analysis to uncover the real problem at hand.',
    cases: [{ ...ITV, href: '/cases/interactive-tv/#chapter-03' }, { ...A11Y, href: '/cases/a11y/#chapter-03' }] },
  { t: 'Define & Strategize', d: 'Transform insights into clear problem statements, strategic alliances and design principles that guide all subsequent decisions.',
    cases: [{ ...A11Y, href: '/cases/a11y/#chapter-04' }, { ...UMA, href: '/cases/cornelsen-uma/#chapter-03' }] },
  { t: 'Design & Prototype', d: 'Rapid ideation, prototyping, and testing to validate concepts before investing in full development.',
    cases: [{ ...ITV, href: '/cases/interactive-tv/#chapter-06' }] },
  { t: 'Deliver, Learn & Iterate', d: 'Ship with confidence, measure impact, and continuously improve based on real user feedback and data.',
    cases: [{ ...UMA, href: '/cases/cornelsen-uma/#chapter-06' }] },
];
const experience = [
  { y: '2021–2025', co: 'JOYN / SevenOne / Pro7Sat1', role: 'VP Product Design & UX Research', d: 'Led UX Design and Research for one of Germany’s largest streaming platforms, driving user growth, engagement, and content discovery across web, mobile, and TV.' },
  { y: '2018–2021', co: 'Cornelsen Publishing Group', role: 'Creative / UX Team Lead', d: 'Led UX for Cornelsen’s digital ecosystem including eCommerce platform and teach & learn platforms, focusing on conversion optimization and content discovery.' },
  { y: '2014–2018', co: 'waipu.tv / Exaring / ui/deation', role: 'UX Lead Designer', d: 'Led UX for waipu.tv multi-platform IPTV products across web, mobile, TV, and voice (Alexa), focusing on user acquisition, engagement, and retention.' },
  { y: '2008–2014', co: 'OVI / Nokia Maps / HERE', role: 'UX Design Team Lead', d: 'Led UX for global location-based services and mapping products, designing navigation, search and real-time location sensing experiences across web and mobile.' },
];
const training = [
  { y: '2026', t: 'AI Manager Advanced', d: 'Two-month full-time certification. The principle I bring into every AI workflow: human in the loop.', href: 'https://lnkd.in/p/gkx386wE', link: 'My takeaways on LinkedIn' },
];
---
<Base title="About — Andreas Schwankl, Product Design Director" description="Andreas Schwankl — Product Design Director in Berlin. Design and research leadership for digital products, from first insight to lasting practice." active="about">
  <section class="section page-head about-hero" data-theme="earth" aria-labelledby="about-title">
    <div class="about-hero__grid is-content">
      <div class="about-hero__text">
        <p class="t-label-caps-small text-muted">About me</p>
        <h1 id="about-title" class="t-display-h1">Product <span class="t-script about-hero__script">Design</span><br />Director</h1>
        <p class="t-body-large text-secondary">For 15+ years I have led design teams and since JOYN also a research team. I have built products from early concepts to releases used by millions, in streaming media, social location, e-commerce and digital education.</p>
        <p class="t-body-default text-secondary">My work starts with understanding people and context and becomes especially interesting when new ways of working are needed in an organisation.</p>
        <ul class="tags" aria-label="Jump to a section">{jumps.map((j) => <li><a class="tag tag--link t-ui-tag" href={j.href}>{j.label}</a></li>)}</ul>
      </div>
      <div class="about-hero__portrait">
        <Image src={portrait} alt="Illustrated portrait of Andreas Schwankl in a beanie and a sweater with a planet earth print, a small fish peeking over his shoulder." widths={[300, 450, 742]} sizes="(max-width: 743px) 70vw, 340px" loading="eager" />
      </div>
    </div>
  </section>

  <section class="section about-quote" aria-label="My leadership approach">
    <figure class="about-quote__inner is-content">
      <blockquote class="t-quote-large">“I make complexity visible, bring people behind a shared direction, and build teams that keep moving.”</blockquote>
      <figcaption class="t-body-caption">— My leadership approach in essence —</figcaption>
    </figure>
  </section>

  <section class="section about-values" data-theme="sand" id="values" aria-labelledby="values-title">
    <div class="about-center is-content">
      <h2 id="values-title" class="t-display-h2">Values &amp; Principles</h2>
      <p class="t-body-default text-secondary">These principles have shaped how I design, how I lead teams and how I approach complex challenges. <span class="cards-hint cards-hint--tap" aria-hidden="true">Tap a card to turn it.</span></p>
    </div>
    <ul class="tarot-deck is-content" data-deck aria-label="Six cards, one for each value and principle">
      {values.map((v, i) => (
        <li class="tarot-slot" style={`--i:${i}`}>
          <button class="tarot" type="button" data-flipped="false">
            <span class="visually-hidden">My {ordinals[i]} value and principle. {v.name}, a theme standing for “{v.t}”. Why? Because: {v.d} {i < values.length - 1 ? 'Please select the next card to learn more.' : 'This was my last card. Thank you for reading.'}</span>
            <span class="tarot__inner">
              <span class="tarot__face tarot__face--front"><Image src={card(v.slug, 'front')} alt="" widths={[300, 440, 640]} sizes="(max-width: 743px) 72vw, (max-width: 1023px) 40vw, 360px" /></span>
              <span class="tarot__face tarot__face--back"><Image src={card(v.slug, 'back')} alt="" widths={[300, 440, 640]} sizes="(max-width: 743px) 72vw, (max-width: 1023px) 40vw, 360px" /></span>
            </span>
          </button>
        </li>
      ))}
    </ul>
  </section>

  <section class="section about-approach" data-theme="sand" id="approach" aria-labelledby="approach-title">
    <h2 id="approach-title" class="t-display-h2 is-content">My Design Approach</h2>
    <div class="approach is-content">
      <Image class="approach__arrows" src={processArrows} alt="" widths={[900, 1600, 2700]} sizes="(max-width: 743px) 900px, 1600px" loading="lazy" />
      <svg class="approach__diamonds" viewBox="0 0 200 560" preserveAspectRatio="none" aria-hidden="true"><path d="M100 0L200 140L100 280L0 140Z M100 280L200 420L100 560L0 420Z"/></svg>
      <ol class="steps" data-steps>
        {approach.map((s) => (
          <li class="step">
            <div class="step__head">
              <h3 class="step__title"><span class="t-highlight">{s.t}</span></h3>
              <ul class="step__cases" aria-label="See it in practice">
                {s.cases.map((c) => <li><a class="case-pill t-ui-tag" data-accent={c.accent} href={c.href}>{c.label}<span class="visually-hidden"> case study</span></a></li>)}
              </ul>
            </div>
            <p class="step__desc"><span class="t-highlight">{s.d}</span></p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section about-exp" id="experience" aria-labelledby="exp-title">
    <div class="exp is-content">
      <div class="exp__head">
        <h2 id="exp-title" class="t-display-h2">Experience</h2>
        <p class="t-body-default text-secondary">A selection of the roles that shaped how I work.</p>
        <p><a class="btn btn--primary t-ui-button" href={cv} download>Download CV <span aria-hidden="true">↓</span><span class="visually-hidden"> (PDF)</span></a></p>
      </div>
      <ol class="timeline">
        {experience.map((e) => (
          <li class="timeline__item">
            <p class="t-label-caps-small text-muted">{e.y}</p>
            <h3 class="t-heading-h4">{e.role} <span class="timeline__co">· {e.co}</span></h3>
            <p class="t-body-small text-secondary">{e.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section about-exp" id="training" aria-labelledby="training-title">
    <div class="exp is-content">
      <div class="exp__head">
        <h2 id="training-title" class="t-display-h2">Certifications &amp; Training</h2>
        <p class="t-body-default text-secondary">How I keep learning alongside the work.</p>
      </div>
      <ol class="timeline">
        {training.map((e) => (
          <li class="timeline__item">
            <p class="t-label-caps-small text-muted">{e.y}</p>
            <h3 class="t-heading-h4">{e.t}</h3>
            <p class="t-body-small text-secondary">{e.d}{e.href && <> <a class="ext-link" href={e.href} target="_blank" rel="noopener">{e.link}<span class="visually-hidden"> (opens in a new tab)</span></a></>}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <ContactTeaser headline="Got a challenge that needs design leadership?" theme="warm-white" />
</Base>
<style>
  .about-hero { padding-bottom: 0; overflow: hidden; }
  .about-hero__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-8); align-items: end; }
  .about-hero__text { display: grid; gap: var(--space-4); align-self: start; padding-bottom: var(--space-16); }
  .about-hero__text > * { margin: 0; }
  .about-hero__script { text-transform: uppercase; font-size: 0.86em; color: var(--color-accent-green-text); white-space: nowrap; }
  .about-hero__portrait { justify-self: center; width: min(100%, 340px); }
  .about-hero__portrait :global(img) { display: block; width: 100%; height: auto; }
  .tags { margin: var(--space-2) 0 0; }
  .tag--link { text-decoration: none; transition: transform .15s, box-shadow .15s; }
  .tag--link::after { content: ' ↓'; }
  .tag--link:hover { transform: translateY(-1px); box-shadow: 0 0 0 2px var(--color-text-primary); }

  .about-quote { background: var(--color-bg-emphasis); color: #fff; }
  .about-quote__inner { margin: 0 auto; max-width: 820px; text-align: center; display: grid; gap: var(--space-4); }
  .about-quote__inner blockquote { margin: 0; }
  .about-quote__inner figcaption { color: #fff; }

  .about-center { text-align: center; max-width: 640px; margin-inline: auto; display: grid; gap: var(--space-4); }
  .about-center > * { margin: 0; }

  /* ── Values & Principles: tarot deck ─────────────────────────── */
  .about-values { row-gap: var(--space-12); }
  .cards-hint { display: block; margin-top: var(--space-2); font-weight: 600; color: var(--color-text-primary); }
  @media (hover: hover) and (pointer: fine) { .cards-hint--tap { display: none; } }

  .tarot-deck { list-style: none; margin: 0 auto; padding: 0; width: 100%; max-width: 1000px;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-10, 40px) var(--space-8); }
  .tarot-slot { position: relative; --tilt: 0deg; }
  .tarot-slot:nth-child(3n+1) { --tilt: -1.2deg; }
  .tarot-slot:nth-child(3n+3) { --tilt: 1deg; }
  .tarot { all: unset; display: block; width: 100%; aspect-ratio: 2 / 3; cursor: pointer; perspective: 1400px; border-radius: 16px;
    transform: rotate(var(--tilt)); transition: transform .35s ease; -webkit-tap-highlight-color: transparent; }
  .tarot:focus-visible { outline: 3px solid var(--color-text-primary); outline-offset: 6px; }
  .tarot__inner { position: relative; display: block; width: 100%; height: 100%; transform-style: preserve-3d;
    transition: transform .7s cubic-bezier(.3, .7, .25, 1); }
  .tarot__face { position: absolute; inset: 0; border-radius: 16px; overflow: hidden; backface-visibility: hidden; -webkit-backface-visibility: hidden;
    background: #f8f4e8; border: 1px solid rgba(26,26,34,.14);
    box-shadow: 0 1px 2px rgba(26,26,34,.10), 0 18px 36px -18px rgba(26,26,34,.45); }
  .tarot__face :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .tarot__face--back { transform: rotateY(180deg); }
  .tarot[data-flipped="true"] .tarot__inner, .tarot:focus-visible .tarot__inner { transform: rotateY(180deg); }
  @media (hover: hover) and (pointer: fine) {
    .tarot:hover { transform: rotate(0deg) translateY(-6px); }
    .tarot:hover .tarot__inner { transform: rotateY(180deg); }
  }

  /* Deal-in: cards slide in like being laid onto the table (only with JS) */
  .tarot-deck[data-anim] .tarot-slot { opacity: 0; transform: translate(-30px, -50px) rotate(-10deg) scale(.92);
    transition: opacity .5s ease, transform .8s cubic-bezier(.2, .8, .2, 1); transition-delay: calc(var(--i) * 110ms); }
  .tarot-deck[data-anim].is-dealt .tarot-slot { opacity: 1; transform: none; }

  /* ── Design approach ─────────────────────────────────────────── */
  .about-approach { overflow: hidden; }
  .approach { position: relative; padding-left: 220px; margin-top: var(--space-4); }
  .approach { isolation: isolate; }
  .approach__diamonds { position: absolute; z-index: 0; left: 0; top: 0; width: 170px; height: 100%; fill: #e4e1d8; pointer-events: none; }
  /* Arrows layer from process-bg-diamond.png: scaled so its diamonds match the SVG diamonds (diamond = 1289 of 1500px height, starts at 72/91px) */
  .approach :global(.approach__arrows) { position: absolute; z-index: 0; left: 0; top: 0; height: 116.37%; width: auto; max-width: none; transform: translate(-2.667%, -6.07%); pointer-events: none; }
  .steps { position: relative; z-index: 1; list-style: none; margin: 0; padding: 0; display: grid; }
  .step { display: grid; gap: var(--space-3); align-content: center; min-height: 140px; padding: var(--space-4) 0; }
  .step > * { margin: 0; }
  .step__head { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-4); }
  .step__title { margin: 0; font-size: 1.375rem; line-height: 1.55; font-weight: 700; }
  .step__desc { max-width: 640px; font-size: 1rem; line-height: 1.95; }
  .step__cases { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .case-pill { display: inline-block; padding: 4px 12px; border-radius: var(--radius-pill); text-decoration: none;
    background: var(--accent-fill); color: var(--accent-on, var(--color-text-on-accent)); transition: transform .15s, box-shadow .15s; }
  .case-pill::after { content: ' →'; }
  .case-pill:hover { transform: translateY(-1px); box-shadow: 0 0 0 2px var(--color-text-primary); }

  .steps[data-anim] .step { opacity: 0; transform: translateX(56px); transition: opacity .6s ease, transform .7s cubic-bezier(.2, .8, .2, 1); }
  .steps[data-anim] .step.is-in { opacity: 1; transform: none; }

  /* ── Experience ──────────────────────────────────────────────── */
  .exp { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--space-12); align-items: start; }
  .exp__head { display: grid; gap: var(--space-4); position: sticky; top: var(--space-24); }
  .exp__head > * { margin: 0; }
  .timeline { list-style: none; margin: 0; padding: 0 0 0 var(--space-6); border-left: 2px solid var(--color-border-strong); display: grid; gap: var(--space-8); }
  .timeline__item { position: relative; display: grid; gap: var(--space-1, 4px); }
  .timeline__item > * { margin: 0; }
  .timeline__item::before { content: ''; position: absolute; left: calc(-1 * var(--space-6) - 7px); top: 4px; width: 12px; height: 12px; border-radius: 50%; background: var(--color-accent-green-fill); border: 2px solid var(--color-bg-page); }
  .timeline__co { font-weight: 500; color: var(--color-text-secondary); }

  @media (max-width: 1023px) {
    .about-hero__grid { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); }
    .exp { grid-template-columns: 1fr; gap: var(--space-8); }
    .exp__head { position: static; }
    .approach { padding-left: 150px; }
    .approach__diamonds { width: 120px; }
  }
  /* Tablet portrait: 3 rows of 2 cards */
  @media (min-width: 744px) and (max-width: 1023px) and (orientation: portrait) {
    .tarot-deck { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 620px; }
    .tarot-slot:nth-child(n) { --tilt: 0deg; }
    .tarot-slot:nth-child(odd) { --tilt: -1deg; }
    .tarot-slot:nth-child(even) { --tilt: .8deg; }
  }
  @media (max-width: 743px) {
    .about-hero__grid { grid-template-columns: 1fr; gap: 0; }
    .about-hero__text { padding-bottom: var(--space-8); }
    .about-hero__portrait { width: min(70%, 280px); }
    .about-hero__script { white-space: normal; }
    /* Phone: swipeable row of cards */
    .tarot-deck { grid-column: full; max-width: none; display: flex; gap: var(--space-5, 20px); overflow-x: auto; scroll-snap-type: x mandatory;
      padding: var(--space-4) var(--margin) var(--space-8); scroll-padding-inline: var(--margin); scrollbar-width: none; }
    .tarot-deck::-webkit-scrollbar { display: none; }
    .tarot-slot { flex: 0 0 72vw; max-width: 320px; scroll-snap-align: center; }
    .tarot-slot:nth-child(n) { --tilt: 0deg; }
    /* Steps: pills under the description, diamond cut in half at the left edge */
    .approach { padding-left: var(--space-8); }
    .approach__diamonds { left: calc(-1 * var(--margin) - 64px); width: 128px; }
    .approach :global(.approach__arrows) { left: calc(-1 * var(--margin) - 64px); }
    .step { min-height: 0; padding: var(--space-6) 0; }
    .step__head { display: contents; }
    .step__title { order: 1; font-size: 1.25rem; }
    .step__desc { order: 2; }
    .step__cases { order: 3; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tarot, .tarot__inner, .case-pill, .tag--link { transition: none; }
    .tarot-deck[data-anim] .tarot-slot, .steps[data-anim] .step { opacity: 1; transform: none; transition: none; }
  }
</style>
<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;

  // Tarot cards: tap (touch) or keyboard turns a card; mouse users turn it by hovering
  document.querySelectorAll<HTMLButtonElement>('.tarot').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      if (canHover && e.detail > 0) return;
      btn.dataset.flipped = btn.dataset.flipped === 'true' ? 'false' : 'true';
    });
  });

  if (!reduce && 'IntersectionObserver' in window) {
    // Deal the deck once the section scrolls into view
    const deck = document.querySelector<HTMLElement>('[data-deck]');
    if (deck) {
      deck.setAttribute('data-anim', '');
      const io = new IntersectionObserver((entries) => {
        entries.forEach((en) => { if (en.isIntersecting) { deck.classList.add('is-dealt'); io.disconnect(); } });
      }, { threshold: 0.15 });
      io.observe(deck);
    }
    // Approach steps slide in from the right on the way down, and back out on the way up
    const steps = document.querySelector<HTMLElement>('[data-steps]');
    if (steps) {
      steps.setAttribute('data-anim', '');
      const io2 = new IntersectionObserver((entries) => {
        entries.forEach((en) => {
          if (en.isIntersecting) en.target.classList.add('is-in');
          else if (en.boundingClientRect.top > 0) en.target.classList.remove('is-in');
        });
      }, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' });
      steps.querySelectorAll('.step').forEach((s) => io2.observe(s));
    }
  }
</script>
