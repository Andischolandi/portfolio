---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactTeaser from '../components/ContactTeaser.astro';
import portrait from '../assets/profile/profile-landing.png';
import logos from '../assets/profile/client-logos.png';
import logosMobile from '../assets/profile/client-logos-mobile.png';
const latest = (await getCollection('cases', (c) => !c.data.hidden && c.data.section === 'latest')).sort((a, b) => a.data.order - b.data.order).slice(0, 2);
const cv = '/cv/CV_Andreas-Schwankl_2026-10_eng.pdf';
// Key facts strip (first draft — light, low-key typography)
const facts = [
  { n: '7', sr: '7', l: 'UX Teams', d: ['Built and led over 15+ years'] },
  { n: '1', sr: '1', l: 'UX LT', lsr: 'UX leadership team', d: ['Built and led at JOYN, including UX Research'] },
  { n: '6 → 25', sr: 'From 6 to 25', l: 'UX professionals', d: ['Scaled and embedded', 'in product squads', 'at SevenOne/JOYN'] },
  { n: '6', sr: '6', l: 'Industries', d: ['Telecoms, maps,', 'streaming, education,', 'e-commerce & SaaS'] },
  { n: '+20%', sr: 'Plus 20 percent', l: 'USAT JOYN', lsr: 'user satisfaction at JOYN', d: ['Helped improve', 'through search, home and onboarding', 'redesigns & more'] },
  { n: '7M+', sr: 'More than 7 million', l: 'MAU', lsr: 'monthly active users', d: ['Supported JOYN’s', 'growth through', 'design and research'] },
];
const clients = 'Vodafone, hobnox, HERE, waipu.tv, Joyn, WDR, Ovi by Nokia, ui/deation, Cornelsen and Seven.One Entertainment Group';
---
<Base landing title="Andreas Schwankl — Product Design Director" description="Andreas Schwankl — Product Design Director in Berlin. Design and research leadership for digital products, from first insight to lasting practice.">
  <section class="section home-hero" data-theme="sand" aria-labelledby="hero-title">
    <p class="visually-hidden">Welcome to the portfolio of Andreas Schwankl. This page gives you an overview of, and access to, some of the projects and case studies Andreas has worked on in recent years. The main navigation is at the top of the page. Further down you will find a short introduction, case studies and latest projects, the clients and employers he has worked for, his design philosophy, and how to get in touch.</p>
    <div class="home-hero__grid is-wide">
      <div class="home-hero__text">
        <p class="t-label-caps-small">Product Design Director<span aria-hidden="true"> · </span><span class="visually-hidden">, </span><span class="t-script hands-on">Hands-on</span><span aria-hidden="true"> · </span><span class="visually-hidden">, </span>Berlin</p>
        <h1 id="hero-title" class="t-display-hero">Design impactful <span class="t-script home-hero__script">experiences</span> through insight.</h1>
        <p class="t-body-large text-secondary">15+ years turning complex product challenges into clear direction — and leading design and research teams to experiences that last.</p>
        <p class="t-body-large text-secondary home-hero__news"><strong>Just recently,</strong> I completed a 2 month full-time training as AI Manager Advanced. <a class="ext-link" href="https://lnkd.in/p/gkx386wE" target="_blank" rel="noopener">Learn more about my takeaways.<span class="visually-hidden"> (LinkedIn, opens in a new tab)</span></a></p>
        <p class="home-hero__ctas">
          <a class="btn btn--primary t-ui-button" href="/projects/">View selected work <span aria-hidden="true">→</span></a>
          <a class="btn btn--secondary t-ui-button" href="/about/">About me <span aria-hidden="true">→</span></a>
          <a class="btn btn--secondary t-ui-button" href={cv} download>Download CV <span aria-hidden="true">↓</span><span class="visually-hidden"> (PDF)</span></a>
        </p>
      </div>
      <div class="home-hero__portrait">
        <Image src={portrait} alt="Illustrated portrait of Andreas Schwankl with beanie, glasses and beard, showing a peace sign." widths={[360, 540, 760, 1080]} sizes="(max-width: 743px) 80vw, (max-width: 1023px) 40vw, 511px" loading="eager" />
      </div>
    </div>
  </section>

  <section class="section home-work" data-theme="sand" aria-labelledby="latest-title">
    <h2 id="facts-title" class="visually-hidden">Facts and figures</h2>
    <ul class="facts is-content" aria-labelledby="facts-title">
      {facts.map((f, i) => (
        <li class="fact" hidden={i >= 4}>
          <p class="fact__head"><span class="fact__num"><span aria-hidden="true">{f.n}</span><span class="visually-hidden">{f.sr}</span></span> {f.lsr ? <span class="fact__label"><span aria-hidden="true">{f.l}</span><span class="visually-hidden">{f.lsr}</span></span> : <span class="fact__label">{f.l}</span>}</p>
          <p class="fact__detail">{f.d.map((line, k) => <><span class="fact__line">{line}</span>{k < f.d.length - 1 ? ' ' : ''}</>)}</p>
        </li>
      ))}
    </ul>
    <script is:inline>
      // show a random selection of 4 out of all facts on every page load (original order kept)
      (function () { var items = [].slice.call(document.querySelectorAll('.facts > .fact')); if (items.length <= 4) return;
        var idx = items.map(function (_, i) { return i; }).sort(function () { return Math.random() - 0.5; }).slice(0, 4);
        items.forEach(function (li, i) { li.hidden = idx.indexOf(i) === -1; }); })();
    </script>
    <h2 id="latest-title" class="t-section-title is-content"><span class="t-highlight">Latest projects and cases</span></h2>
    <div class="grid-2 is-wide">{latest.map((e) => <ProjectCard entry={e} />)}</div>
    <p class="home-work__all is-content"><a class="btn btn--primary t-ui-button" href="/projects/">Case Studies · View all <span aria-hidden="true">→</span></a></p>
    <h2 id="clients-title" class="visually-hidden">Clients and employers</h2>
    <figure class="clients is-wide" aria-labelledby="clients-title">
      <picture>
        <source media="(max-width: 743px)" srcset={logosMobile.src} width={logosMobile.width} height={logosMobile.height} />
        <img src={logos.src} width={logos.width} height={logos.height} alt={`Clients I have worked for, in order: ${clients}.`} draggable="false" loading="lazy" decoding="async" />
      </picture>
    </figure>
  </section>

  <section class="section home-quote" data-theme="earth" aria-labelledby="philosophy-title">
    <div class="home-quote__inner is-content">
      <h2 id="philosophy-title" class="t-label-caps-large text-muted">My Design Philosophy</h2>
      <p class="t-quote-large">“I approach design leadership as I approach product design: understanding people, context and goals, exploring possibilities and learning through experimentation—to shape better products and better ways of working.”</p>
      <p><a class="home-quote__link t-label-caps-small" href="/about/#values">Read my values &amp; principles <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <ContactTeaser headline="Got a challenge that needs design expertise?" />
</Base>
<style>
  .home-hero { padding-block: var(--space-4) 0; overflow: hidden; }
  /* Grid spans the wide column so the portrait's right edge lines up with the right project card below;
     the text keeps starting on the content edge (inset = half the difference between wide and content). */
  .home-hero__grid { --inset: calc((var(--wide) - var(--content)) / 2); display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: var(--space-8); align-items: end; padding-left: var(--inset); }
  .home-hero__text { display: grid; gap: var(--space-6); align-self: start; padding-bottom: var(--space-16); }
  .home-hero__text h1 { margin-top: var(--space-20, 80px); }
  .home-hero__text > * { margin: 0; }
  .home-hero__text .t-body-large { max-width: 34em; }
  .home-hero__news { margin-top: calc(var(--space-6) * -0.5) !important; }
  .home-hero__news strong { color: var(--color-text-primary); }
  .hands-on { text-transform: uppercase; letter-spacing: 0.08em; font-size: 1.1em; }
  /* Kalam sits high on its line box; tighten the box and drop the word onto the Inter baseline rhythm */
  .home-hero__script { display: block; text-transform: uppercase; letter-spacing: 0.01em; line-height: 0.9; padding-top: 0.19em; margin-bottom: -0.2em; }
  .home-hero__ctas { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .home-hero__portrait { align-self: end; justify-self: end; width: min(100%, 511px); }
  .home-hero__portrait :global(img) { display: block; width: 100%; height: auto; }
  .home-work { padding-top: var(--space-16); }
  /* Facts strip: deliberately quiet — light numerals, regular labels, hairline rules */
  .facts { list-style: none; margin: 0 0 var(--space-12); padding: var(--space-6) 0 0;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-6) var(--space-8); }
  .fact { display: grid; gap: var(--space-3); align-content: start; }
  .fact[hidden] { display: none; }
  .fact > p { margin: 0; }
  .fact__head { display: grid; gap: 2px; }
  .fact__num { font-weight: 400; font-size: 2.5rem; line-height: 1.1; letter-spacing: -0.01em; color: var(--color-text-primary); }
  .fact__label { font-size: 1.0625rem; font-weight: 700; line-height: 1.3; color: var(--color-text-primary); }
  .fact__detail { font-size: 0.9375rem; line-height: 1.55; color: var(--color-text-secondary); }
  .grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-6); }
  .home-work__all { display: flex; justify-content: center; margin: var(--space-6) 0 0; }
  .clients { margin: var(--space-12) 0 0; user-select: none; -webkit-user-select: none; pointer-events: none; }
  .clients img { display: block; width: 100%; height: auto; }
  .home-quote__inner { display: grid; gap: var(--space-6); text-align: center; justify-items: center; max-width: 820px; margin-inline: auto; }
  .home-quote__inner > * { margin: 0; }
  .home-quote__inner .t-quote-large { font-weight: 400; }
  .home-quote__link { color: var(--accent-text, var(--color-accent-green-text)); text-decoration: none; }
  .home-quote__link:hover { text-decoration: underline; }
  @media (max-width: 1023px) {
    .home-hero__grid { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: var(--space-6); padding-left: 0; }
    .home-hero__text { padding-bottom: var(--space-12); }
    .home-hero__text h1 { margin-top: var(--space-16); }
    .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 743px) {
    .clients img { max-width: 420px; margin-inline: auto; }
    .home-hero { padding-top: var(--space-4); }
    .home-hero__text h1 { margin-top: var(--space-12); }
    .home-hero__grid { grid-template-columns: 1fr; gap: 0; }
    .home-hero__text { padding-bottom: var(--space-8); }
    .home-hero__portrait { width: min(78%, 360px); justify-self: end; }
    .grid-2 { grid-template-columns: 1fr; }
    .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-10, 40px) var(--space-4); margin-bottom: var(--space-10, 40px); }
    .fact__num { font-size: 2.125rem; }
    .fact__label { font-size: 0.9375rem; }
    /* Mobile: fixed line breaks as designed */
    .fact__line { display: block; }
    .fact__detail { font-size: min(0.9375rem, 3.8vw); }
    .clients { margin-top: var(--space-8); }
  }
</style>
